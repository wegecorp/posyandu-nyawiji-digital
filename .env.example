# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit `.env` asli. Semua nilai di bawah WAJIB diganti di produksi.
# PostgreSQL: buat DB dulu (createdb nyawiji) lalu sesuaikan user/password/port.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nyawiji?schema=public"
NEXT_PUBLIC_APP_NAME="PORTAL NYAWIJI"

# Wajib: string acak panjang (mis. 64+ karakter). Aplikasi gagal start di produksi bila kosong.
SESSION_SECRET=""

# Akun super-admin DINKES. Ganti password sebelum deploy.
DINKES_ADMIN_USERNAME="dinkes_gk"
DINKES_ADMIN_PASSWORD=""

# Password default akun baru (kader & staf). WAJIB beda satu sama lain.
POSYANDU_DEFAULT_PASSWORD=""
PUSKESMAS_DEFAULT_PASSWORD=""

# --- MONITORING & ANALYTICS (Opsional) ---
# Cloudflare Web Analytics (Token dari dash.cloudflare.com -> Web Analytics)
NEXT_PUBLIC_CF_BEACON_TOKEN=""

# Sentry Error & Latency Tracking (DSN dari sentry.io -> Project Settings -> Client Keys)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Sentry Build/Release upload sourcemaps (opsional)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
