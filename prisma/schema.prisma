datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Kapanewon {
  id             String         @id @default(cuid())
  code           String         @unique // e.g. WNS
  name           String         // e.g. Wonosari
  healthCenters  HealthCenter[]
  kalurahan      Kalurahan[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Kalurahan {
  id            String      @id @default(cuid())
  code          String      @unique // e.g. WNS-BLH
  name          String      // e.g. Baleharjo
  kapanewonId   String
  kapanewon     Kapanewon   @relation(fields: [kapanewonId], references: [id], onDelete: Cascade)
  posyandus     Posyandu[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model HealthCenter {
  id          String      @id @default(cuid())
  code        String      @unique // e.g. PKM-WONOSARI-1
  name        String      // e.g. Puskesmas Wonosari I
  kapanewonId String
  kapanewon   Kapanewon   @relation(fields: [kapanewonId], references: [id], onDelete: Restrict)
  users       User[]
  posyandus   Posyandu[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Posyandu {
  id              String        @id @default(cuid())
  code            String        @unique // e.g. POS-WNS-01
  name            String        // e.g. Posyandu Melati Padukuhan Purbosari
  kalurahanId     String
  kalurahan       Kalurahan     @relation(fields: [kalurahanId], references: [id], onDelete: Restrict)
  padukuhan       String        @default("-") // e.g. Purbosari
  healthCenterId  String
  healthCenter    HealthCenter  @relation(fields: [healthCenterId], references: [id], onDelete: Cascade)
  users           User[]
  patients        Patient[]
  measurements    Measurement[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model User {
  id                  String        @id @default(cuid())
  username            String        @unique // kode internal; dipakai login hanya utk role staf
  password            String        // 1 akun 1 password
  name                String        // Nama entitas / institusi
  role                String        @default("POSYANDU") // DINKES, PUSKESMAS, POSYANDU
  mustChangePassword  Boolean       @default(true) // akun baru wajib aktivasi (ganti password default)
  healthCenterId      String?
  healthCenter        HealthCenter? @relation(fields: [healthCenterId], references: [id], onDelete: Cascade)
  posyanduId          String?
  posyandu            Posyandu?     @relation(fields: [posyanduId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Patient {
  id            String        @id @default(cuid())
  regNumber     String        @unique // e.g. POS-WNS-01-2026-0001
  clientId      String?       @unique // UUID sementara dari klien untuk idempotensi registrasi offline
  name          String
  birthDate     DateTime      // for auto age calculation
  gender        String?       // "L" (Laki-laki) / "P" (Perempuan)
  address       String?       // Text / RT-RW
  guardianName  String?       // Orang tua / Wali (Teks)
  phone         String?       // No HP opsional
  isPregnant    Boolean       @default(false) // Tag bumil
  posyanduId    String
  posyandu      Posyandu      @relation(fields: [posyanduId], references: [id], onDelete: Cascade)
  measurements  Measurement[]
  updatedBy     String?       // Username kader terakhir mengubah
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Measurement {
  id                String    @id @default(cuid())
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  posyanduId        String
  posyandu          Posyandu  @relation(fields: [posyanduId], references: [id], onDelete: Cascade)
  sessionDate       DateTime  @default(now()) // Auto-assigned to today
  ageInMonths       Int       // Calculated at measurement time
  
  // Dynamic fields
  weight            Float?    // BB (kg)
  height            Float?    // TB/PB (cm)
  headCircumference Float?    // Lingkar Kepala (cm)
  armCircumference  Float?    // LiLA (cm)
  systolic          Int?      // Tensi Sistolik (mmHg)
  diastolic         Int?      // Tensi Diastolik (mmHg)
  gestationalAge    Int?      // Usia Kehamilan (Minggu)
  bloodSugar        Float?    // Gula Darah (mg/dL)
  cholesterol       Float?    // Kolesterol (mg/dL)
  uricAcid          Float?    // Asam Urat (mg/dL)
  hemoglobin        Float?    // Hemoglobin / HB (g/dL)
  waistCircumference Float?   // Lingkar Perut (cm)
  imt               Float?    // IMT (auto hitung dari BB/TB)
  visionStatus      String?   // Skrining mata: Normal / Tidak Normal
  hearingStatus     String?   // Skrining telinga: Normal / Tidak Normal
  noteSource        String?   // Sumber catatan: Kader / Nakes
  category          String?   // Snapshot kategori saat pengukuran
  notes             String?   // Catatan kader
  
  recordedBy        String?   // Nama / username posyandu/kader
  updatedBy         String?   // Username kader terakhir mengubah
  version           Int       @default(1) // last-write-wins counter
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([patientId, sessionDate])
  @@index([sessionDate])
}
